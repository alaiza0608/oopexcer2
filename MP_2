import java.util.Scanner;

public class BankAccount {
    private String accountNumber;
    private String ownerName;
    private double balance;
    
    private static int totalAccountsCreated = 0;

    public BankAccount(String accountNumber, String ownerName, double balance) {
        this.accountNumber = accountNumber;
        this.ownerName = ownerName;
        this.balance = balance;
        totalAccountsCreated++; 
    }

    public String getAccountNumber() {
        return this.accountNumber;
    }

    public String getOwnerName() {
        return this.ownerName;
    }

    public double getBalance() {
        return this.balance;
    }

    public static int getTotalAccountsCreated() {
        return totalAccountsCreated;
    }

    public boolean deposit(double amount) {
        if (amount > 0) {
            this.balance += amount;
            return true;
        }
        return false;
    }

    public boolean withdraw(double amount) {
        if (amount > 0 && amount <= this.balance) {
            this.balance -= amount;
            return true;
        }
        return false;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int numAccounts = 0;

        while (true) {
            System.out.print("Enter number of bank accounts to create (1-5): ");
            if (scanner.hasNextInt()) {
                numAccounts = scanner.nextInt();
                if (numAccounts >= 1 && numAccounts <= 5) {
                    break;
                }
            } else {
                scanner.next(); 
            }
            System.out.println("Invalid input. Please enter a number between 1 and 5.");
        }
        scanner.nextLine();

        BankAccount[] accounts = new BankAccount[numAccounts];

        for (int i = 0; i < numAccounts; i++) {
            System.out.println("\n--- Creating Account #" + (i + 1) + " ---");
            System.out.print("Enter Account Number: ");
            String accNum = scanner.nextLine();
            
            System.out.print("Enter Owner Name: ");
            String owner = scanner.nextLine();
            
            double initialBalance = -1;
            while (initialBalance < 0) {
                System.out.print("Enter Opening Balance: ");
                if (scanner.hasNextDouble()) {
                    initialBalance = scanner.nextDouble();
                    if (initialBalance < 0) {
                        System.out.println("Opening balance cannot be negative.");
                    }
                } else {
                    System.out.println("Invalid amount.");
                    scanner.next(); 
                }
            }
            scanner.nextLine(); 

            accounts[i] = new BankAccount(accNum, owner, initialBalance);
        }

        int numTransactions = 0;
        while (true) {
            System.out.print("\nEnter the number of transactions to process: ");
            if (scanner.hasNextInt()) {
                numTransactions = scanner.nextInt();
                if (numTransactions >= 0) {
                    break;
                }
            } else {
                scanner.next();
            }
            System.out.println("Please enter a valid non-negative integer.");
        }
        scanner.nextLine(); 

        for (int i = 0; i < numTransactions; i++) {
            System.out.println("\n--- Processing Transaction #" + (i + 1) + " ---");
            System.out.print("Enter Target Account Number: ");
            String targetAcc = scanner.nextLine();

            BankAccount foundAccount = null;
            for (BankAccount acc : accounts) {
                if (acc.getAccountNumber().equalsIgnoreCase(targetAcc)) {
                    foundAccount = acc;
                    break;
                }
            }

            if (foundAccount == null) {
                System.out.println("Transaction REJECTED: Account number " + targetAcc + " not found.");
                continue;
            }

            System.out.print("Enter Transaction Type (D for Deposit, W for Withdrawal): ");
            String type = scanner.nextLine().trim().toUpperCase();

            System.out.print("Enter Amount: ");
            double amount = 0;
            if (scanner.hasNextDouble()) {
                amount = scanner.nextDouble();
            }
            scanner.nextLine(); 

            if (type.equals("D")) {
                if (foundAccount.deposit(amount)) {
                    System.out.println("Transaction SUCCESSFUL: Deposited $" + amount + " to Account " + targetAcc);
                } else {
                    System.out.println("Transaction REJECTED: Deposit amount must be positive.");
                }
            } else if (type.equals("W")) {
                if (foundAccount.withdraw(amount)) {
                    System.out.println("Transaction SUCCESSFUL: Withdrew $" + amount + " from Account " + targetAcc);
                } else {
                    System.out.println("Transaction REJECTED: Insufficient balance or invalid amount.");
                }
            } else {
                System.out.println("Transaction REJECTED: Invalid transaction type sequence.");
            }
        }

        System.out.println("\n=====================================");
        System.out.println("FINAL ACCOUNT SUMMARY");
        System.out.println("=====================================");
        System.out.println("Total BankAccounts Created: " + BankAccount.getTotalAccountsCreated());
        System.out.println("-------------------------------------");
        
        for (BankAccount acc : accounts) {
            System.out.printf("Account: %s | Owner: %s | Final Balance: $%.2f\n", 
                acc.getAccountNumber(), acc.getOwnerName(), acc.getBalance());
        }
        System.out.println("=====================================");

        scanner.close();
    }
}
