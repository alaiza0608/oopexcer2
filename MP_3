import java.util.Scanner;

public class Product {
    private String code;
    private String name;
    private double price;
    private int stock;
    
    private static int totalProductsCreated = 0;

    public Product(String code, String name, double price, int stock) {
        this.code = code;
        this.name = name;
        setPrice(price);
        setStock(stock); 
        totalProductsCreated++;
    }

    public String getCode() {
        return this.code;
    }

    public String getName() {
        return this.name;
    }

    public double getPrice() {
        return this.price;
    }

    public int getStock() {
        return this.stock;
    }

    public static int getTotalProductsCreated() {
        return totalProductsCreated;
    }

    public void setPrice(double price) {
        if (price >= 0) {
            this.price = price;
        } else {
            this.price = 0;
            System.out.println("Warning: Price cannot be negative. Set to 0.");
        }
    }

    public void setStock(int stock) {
        if (stock >= 0) {
            this.stock = stock;
        } else {
            this.stock = 0;
            System.out.println("Warning: Stock cannot be negative. Set to 0.");
        }
    }

    public void restock(int quantity) {
        if (quantity > 0) {
            this.stock += quantity;
            System.out.println("Successfully restocked " + quantity + " units of " + this.name + ".");
        } else {
            System.out.println("Transaction Failed: Restock quantity must be positive.");
        }
    }

    public void sell(int quantity) {
        if (quantity <= 0) {
            System.out.println("Transaction Failed: Selling quantity must be positive.");
        } else if (quantity > this.stock) {
            System.out.println("Transaction Failed: Insufficient stock for " + this.name + " (Available: " + this.stock + ").");
        } else {
            this.stock -= quantity;
            System.out.println("Successfully sold " + quantity + " units of " + this.name + ".");
        }
    }

    public double getInventoryValue() {
        return this.price * this.stock;
    }

    public boolean isLowStock() {
        return this.stock <= 5;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        int numProducts = 0;
        while (numProducts < 1 || numProducts > 8) {
            System.out.print("Enter number of products to register (1-8): ");
            if (scanner.hasNextInt()) {
                numProducts = scanner.nextInt();
                if (numProducts < 1 || numProducts > 8) {
                    System.out.println("Invalid input. Please enter a number between 1 and 8.");
                }
            } else {
                System.out.println("Invalid input. Please enter an integer.");
                scanner.next(); 
            }
        }
        scanner.nextLine(); 

        Product[] inventory = new Product[numProducts];

        System.out.println("\n--- ENTER PRODUCT RECORDS ---");
        for (int i = 0; i < numProducts; i++) {
            System.out.println("\nProduct #" + (i + 1));
            System.out.print("Enter Product Code: ");
            String code = scanner.nextLine();
            
            System.out.print("Enter Product Name: ");
            String name = scanner.nextLine();
            
            System.out.print("Enter Unit Price: ");
            double price = scanner.nextDouble();
            
            System.out.print("Enter Opening Stock: ");
            int stock = scanner.nextInt();
            scanner.nextLine(); 

            inventory[i] = new Product(code, name, price, stock);
        }

        System.out.print("\nEnter the number of transactions to process: ");
        int numTransactions = scanner.nextInt();
        scanner.nextLine(); 

        System.out.println("\n--- PROCESSING TRANSACTIONS ---");
        for (int t = 1; t <= numTransactions; t++) {
            System.out.println("\nTransaction #" + t);
            System.out.print("Enter Product Code: ");
            String searchCode = scanner.nextLine();

            Product targetProduct = null;
            for (Product p : inventory) {
                if (p.getCode().equalsIgnoreCase(searchCode)) {
                    targetProduct = p;
                    break;
                }
            }

            if (targetProduct == null) {
                System.out.println("Transaction Error: Product code '" + searchCode + "' not found.");
                continue; 
            }

            System.out.print("Enter Action (R for Restock / S for Sell): ");
            String action = scanner.nextLine().trim().toUpperCase();

            System.out.print("Enter Quantity: ");
            int quantity = scanner.nextInt();
            scanner.nextLine(); 

            if (action.equals("R")) {
                targetProduct.restock(quantity);
            } else if (action.equals("S")) {
                targetProduct.sell(quantity);
            } else {
                System.out.println("Transaction Error: Invalid action type. Use 'R' or 'S'.");
            }
        }

        System.out.println("\n============================================");
        System.out.println("           PRODUCT STOCK SUMMARY            ");
        System.out.println("============================================");
        
        double totalInventoryValue = 0;

        for (Product p : inventory) {
            double value = p.getInventoryValue();
            totalInventoryValue += value;

            System.out.print("Code: " + p.getCode() + " | Name: " + p.getName() 
                    + " | Stock Remaining: " + p.getStock() + " | Value: $" + String.format("%.2f", value));
            
            if (p.isLowStock()) {
                System.out.print(" [LOW STOCK]");
            }
            System.out.println();
        }

        System.out.println("--------------------------------------------");
        System.out.printf("Total Inventory Value: $%.2f\n", totalInventoryValue);
        System.out.println("Total Product Objects Instantiated: " + Product.getTotalProductsCreated());
        System.out.println("============================================");

        scanner.close();
    }
}

